# --- RTSP source -------------------------------------------------------------
# Camera endpoint as host[:port]/path — no scheme, no credentials.
RTSP_ENDPOINT=192.168.1.10:554/mystream
RTSP_USER=
RTSP_PASS=

# Source geometry (raw frames are resized by ffmpeg to this if the camera differs)
VIDEO_W=1920
VIDEO_H=1080

# --- Pipeline ------------------------------------------------------------------
# Detection/OCR run at this rate; the render stream keeps the full source FPS.
DETECT_FPS=3
# Guard only (ADR-0006): an event's exact plate string re-emitted within this window is suppressed.
DEDUP_WINDOW_S=10
# Plate-track association: sighting box must overlap an open track's box by at least this IoU.
TRACK_IOU_THRESH=0.3

# Which plate formats are validatable (ADR-0008):
#   MERCOSUR_ONLY        -> current-era `AB 123 CD` cars only (this default)
#   MERCOSUR_PLUS_LEGACY -> also 1995-2016-era `ABC 123` cars (rows land as
#                           VALIDATED_LEGACY; neighbouring countries sharing the 3+3
#                           shape — Paraguay, Peru — filter as noise by status).
#                           Legacy mode wants the default cct_s_v2_global OCR:
#                           the 7-slot arg_cnn_ocr fallback is Mercosur-length-trained.
PLATE_FORMATS=MERCOSUR_ONLY
# Consecutive detection passes a track may go undetected for before it closes (6 at DETECT_FPS=3 ≈ 2 s).
TRACK_MAX_MISSES=6
# Append-only CSV event log (survives restarts; served at GET /plates.csv).
EVENTS_CSV=events.csv
# ROI as normalized left,top,right,bottom fractions. Empty = full frame.
ROI=
# Minimum detector confidence to keep a plate sighting.
DET_CONF_THRESH=0.4

# --- Models --------------------------------------------------------------------
# Vendored ONNX file names under models/ (fetch them with scripts/fetch_models.py).
DETECTOR_MODEL=yolo-v9-t-384-license-plates-end2end
# Default OCR: cct_s_v2_global  |  fallback: arg_cnn_ocr
OCR_MODEL=cct_s_v2_global

# --- Web dashboard ---------------------------------------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
# Render stream size (source stays native; detection uses the model's native input).
RENDER_W=960
RENDER_H=540
JPEG_QUALITY=70
