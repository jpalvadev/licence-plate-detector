# --- RTSP source -------------------------------------------------------------
# Currently points at the mediamtx test rig (C:\Programacion\mediamtx, stock config).
# Replace with your real camera as host[:port]/path once deployed.
RTSP_ENDPOINT=127.0.0.1:8554/mystream
RTSP_USER=
RTSP_PASS=

# Source geometry (raw frames are resized by ffmpeg to this if the camera differs)
VIDEO_W=1920
VIDEO_H=1080

# --- Pipeline ------------------------------------------------------------------
# Detection/OCR run at this rate; the render stream keeps the full source FPS.
DETECT_FPS=3
# Recognition events: same plate string inside this window = one event.
DEDUP_WINDOW_S=10
# Append-only CSV event log (survives restarts; served at GET /plates.csv).
EVENTS_CSV=events.csv
# Plate evidence photos (ADR-0011): one JPG per logged event, named {plate}_{conf}_{timestamp}.jpg
MEDIA_DIR=media
# ROI as normalized left,top,right,bottom fractions. Empty = full frame.
ROI=
# Minimum detector confidence to keep a plate sighting.
DET_CONF_THRESH=0.4
# Operator's choice (ADR-0008): recognize 1995-2016-era `ABC 123` too (majority of the
# pre-2016 fleet). Keep cct_s_v2_global OCR while this is on; legacy rows = PATENTE_ALFANUM.
PLATE_FORMATS=MERCOSUR_PLUS_LEGACY

# --- Models --------------------------------------------------------------------
# Vendored ONNX file names under models/ (fetch them with scripts/fetch_models.py).
# Detector tiers (same zoo; mAP = upstream eval P/R/mAP50-95; ms on dev CPU) —
# best stays uncommented, accuracy first (see BENCHMARK.md for the measured runs):
#   yolo-v9-s-608-license-plates-end2end  .957/.917/.966/.772 best | 28.6 MB | ~101 ms/pass
#   yolo-v9-t-640-license-plates-end2end  .966/.896/.958/.758      |  7.8 MB | ~58 ms
#   yolo-v9-t-512-license-plates-end2end  .955/.901/.948/.724      |  7.8 MB | ~36 ms
#   yolo-v9-t-416-license-plates-end2end  .940/.894/.940/.702      |  7.8 MB | ~25 ms
#   yolo-v9-t-384-license-plates-end2end  .942/.863/.920/.687 old  |  7.8 MB | ~19 ms
#   yolo-v9-t-256-license-plates-end2end  .937/.797/.858/.606 fast |  7.8 MB | ~11 ms
DETECTOR_MODEL=yolo-v9-s-608-license-plates-end2end
# OCR options (fast-plate-ocr arg-plates; plate acc = mean upstream per-batch val):
#   cct_s_v2_global   97.9% best | 5.3 MB | ~16 ms/crop   (default; AR benchmark 97.2/99.5)
#   cct_s_v1_global   97.5%      | 7.6 MB | ~23 ms/crop   (older, slower)
#   cct_xs_v2_global  97.4%      | 3.3 MB | ~2.2 ms/crop  (7x faster, slightly weaker)
#   cct_xs_v1_global  96.0%      | 2.1 MB | ~1.6 ms/crop  (smallest)
#   arg_cnn_ocr       fallback: Argentina-only fixed 7 slots — keep with MERCOSUR_ONLY only
OCR_MODEL=cct_s_v2_global

# --- Web dashboard ---------------------------------------------------------------
HTTP_HOST=0.0.0.0
# 8080 is taken on this machine by the local LLM server -> use 8090.
HTTP_PORT=8090
# Render stream size (source stays native; detection uses the model's native input).
# RENDER_W=960
# RENDER_H=540
RENDER_W=1920
RENDER_H=1080
JPEG_QUALITY=100
